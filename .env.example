# Copia este archivo como .env y rellena los valores.
# .env está excluido del repositorio: nunca subas la clave real.

# Clave de API de Anthropic (se obtiene en https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Confianza mínima (0 a 1) para que una factura entre en los cálculos sin
# confirmación. Por defecto 0.90. Ver docs/decisiones.md.
UMBRAL_CONFIANZA=0.90
